# Public FastAPI origin. Used at runtime by the /api proxy and passage SSR.
# Local: http://127.0.0.1:8000
# Production: https://api.lociros.com (nginx on Lightsail).
NLP_BACKEND_URL=http://127.0.0.1:8000

# Same value as PROXY_SECRET on the API. Lets the API rate limit each visitor
# by their own address instead of Vercel's shared ones. Server-only.
# PROXY_SECRET=

# Supabase Auth (browser + Next.js proxy). Use the publishable key, never the secret.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is read as a fallback if the publishable key is unset.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Canonical origin for metadata, sitemap, and Open Graph. Default https://lociros.com.
# NEXT_PUBLIC_SITE_URL=https://lociros.com
# Contact address shown in the footer and legal pages. Default hello@lociros.com.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@lociros.com

# Pricing copy only; Stripe charges whatever the backend's STRIPE_PRICE_* IDs say.
# Keep these and the backend's TRIAL_DAYS in step with the Stripe dashboard.
# NEXT_PUBLIC_PRICE_MONTHLY=$9.99
# NEXT_PUBLIC_PRICE_ANNUAL=$79.99
# NEXT_PUBLIC_PRICE_ANNUAL_NOTE=Two-thirds the monthly price.
# NEXT_PUBLIC_TRIAL_DAYS=7

# Error reporting. The public DSN is sent to the browser; SENTRY_DSN is for the server.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Search console verification tokens.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Set to 1 to show the sticky start bar test on the landing page.
# NEXT_PUBLIC_STICKY_START_TEST=1

# Set to 1 only for the static catalog (no Python backend). Leave unset for the live app.
# NEXT_PUBLIC_DEMO=1
