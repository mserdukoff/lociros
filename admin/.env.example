# The only account that can open the dashboard. Required: unset locks everyone out.
# Also list it in the backend's ADMIN_EMAILS.
ADMIN_EMAIL=you@example.com
# FastAPI origin, read on the server only.
NLP_BACKEND_URL=http://127.0.0.1:8000
# Same Supabase project as the main app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dashboard times are shown in this zone.
ADMIN_TIME_ZONE=America/New_York
