OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
DATABASE_URL=sqlite:///./levla.db
JWT_SECRET=dev-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural
SHOW_RUSSIAN=true
SHOW_ITALIAN=true
SHOW_ARABIC=true
# Defaults to true when APP_ENV=production.
REQUIRE_AUTH=false
GENERATE_MONTHLY_CAP=10
APP_ENV=development
LOG_LEVEL=info
# Billing. The paywall is on when APP_ENV=production unless PAYWALL_ENABLED=false.
# PAYWALL_ENABLED=true
# TRIAL_DAYS=7
# FREE_GUEST_PASSAGES=1
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_ANNUAL=price_...
# STRIPE_AUTOMATIC_TAX=true
# Lets DELETE /api/me remove the Supabase Auth user too. Server-side only.
# SUPABASE_SERVICE_ROLE_KEY=
# CONTACT_EMAIL=hello@lociros.com
# NEWS_SCHEDULER=true
# MAX_BODY_BYTES=262144
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Old HS256 magic-link tokens. Off by default in production.
# ALLOW_LEGACY_TOKENS=false
# Who may set X-Forwarded-For (Caddy on the host, Docker bridges).
# FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
# Production / Vercel frontend + Supabase + FastAPI Docker host
# APP_ENV=production
# PUBLIC_BASE_URL=https://YOUR_VERCEL_DOMAIN
# CORS_ORIGINS=https://YOUR_VERCEL_DOMAIN
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# JWT_SECRET=generate-a-long-random-string
# COOKIE_SECURE=true
# DATA_DIR=/app/data
# AUDIO_DIR=/app/backend/audio
# GENERATE_WORKERS=2
# GENERATE_MAX_PENDING=3
# ADMIN_EMAILS=you@example.com
#
# Supabase: copy Session pooler from Dashboard → Connect (port 5432, IPv4).
# Percent-encode reserved characters in the password (&, #, ?, space).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DB_SSLMODE=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Inferred from a direct db.PROJECT.supabase.co DATABASE_URL if unset.
